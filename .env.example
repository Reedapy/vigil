# ─── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_USER=vigil
POSTGRES_PASSWORD=changeme_in_production
POSTGRES_DB=vigil

# ─── API Server ───────────────────────────────────────────────────────────────
# Connection string consumed by the API container. Host/user/password/db must
# match the POSTGRES_* values above. Inside Docker the host is the service name.
DATABASE_URL=postgresql://vigil:changeme_in_production@postgres:5432/vigil

# Shared secret the agent presents once during registration. Set to a long,
# random value in production.
API_SECRET=change_this_to_a_long_random_string

# Port the API listens on inside Docker
API_PORT=4000

# ─── Email alerts (optional SMTP) ─────────────────────────────────────────────
# Leave SMTP_HOST blank to log alert emails instead of sending them.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASS=your_smtp_password
# SMTP_FROM=vigil@yourdomain.com
# SMTP_SECURE=false

# ─── Dashboard ────────────────────────────────────────────────────────────────
# Browser-facing URLs (baked into the client bundle at build time). Must be
# reachable from the user's browser — i.e. the host-published API port.
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:4000

# Server-side (SSR) URL the dashboard container uses to reach the API over the
# internal Docker network. Read at runtime — never exposed to the browser.
API_INTERNAL_URL=http://api:4000

# ─── Agent (set per monitored server) ─────────────────────────────────────────
# Display name shown in the dashboard
VIGIL_SERVER_NAME=my-server

# API base URL the agent POSTs metrics to. Inside Docker this is the service name.
VIGIL_API_URL=http://api:4000

# Agent key issued by the API on first registration. Leave blank until you have
# registered the agent (see the README / Docs page).
VIGIL_AGENT_KEY=

# How often (seconds) the agent collects and ships metrics
VIGIL_INTERVAL=10
